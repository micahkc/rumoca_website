---
import TutorialLayout from '../../../layouts/TutorialLayout.astro';
import ModelWorkbench from '../../../components/tutorials/ModelWorkbench';
---

<TutorialLayout
  title="RC Circuit (Component-Based)"
  breadcrumbs={[
    { label: 'Tutorials', href: '/tutorials' },
    { label: '3D Visualization', href: '/tutorials' },
    { label: 'Circuit (Component-Based)' },
  ]}
  prev={{ label: 'Two-Body Orbit', href: '/tutorials/visualization/two-body-orbit' }}
  next={{ label: 'Simulation with CasADi', href: '/tutorials/workflows/casadi' }}
>
  <p class="text-text-muted leading-relaxed mb-4">
    A component-based circuit model using Modelica connectors and inheritance. Demonstrates packages,
    <code class="font-mono text-sm text-accent">extends</code>, and
    <code class="font-mono text-sm text-accent">connect</code> equations. The
    <code class="font-mono text-sm text-accent">flow</code> keyword enforces Kirchhoff&rsquo;s current law
    automatically at each connection point.
  </p>

  <ModelWorkbench
    client:only="react"
    initialSource={`package Circuit

connector Pin
  Real v "voltage";
  flow Real i "current";
end Pin;

model TwoPin
  Pin p, n;
  Real v;
  Real i;
equation
  v = p.v - n.v;
  i = p.i;
  p.i + n.i = 0;
end TwoPin;

model Ground
  Pin p;
equation
  p.v = 0;
end Ground;

model VoltageSource
  extends TwoPin;
  parameter Real V = 5.0 "V";
equation
  v = V;
end VoltageSource;

model Resistor
  extends TwoPin;
  parameter Real R = 2.5 "Resistance";
equation
  v = R * i;
end Resistor;

model Capacitor
  extends TwoPin;
  parameter Real C = 1e-2 "Capacitance";
equation
  i = C * der(v);
end Capacitor;

model Test
  VoltageSource src;
  Ground gnd;
  Resistor res;
  Capacitor cap;
equation
  connect(src.p, res.p);
  connect(res.n, cap.p);
  connect(cap.n, src.n);
  connect(src.n, gnd.p);
end Test;

end Circuit;`}
    modelName="Circuit.Test"
    tEnd={0.1}
    defaultScript={`ctx.onInit = (api) => {
  const { THREE, state } = api;
  state.scene.background = new THREE.Color(0x101010);
  const light = new THREE.DirectionalLight(0xffffff, 1.0);
  light.position.set(2, 4, 3);
  state.scene.add(light);
  state.scene.add(new THREE.AmbientLight(0x404040, 0.9));
  state.scene.add(new THREE.GridHelper(12, 24, 0x2f4f63, 0x2a2a2a));
  // Circuit board
  const board = new THREE.Mesh(
    new THREE.BoxGeometry(4, 0.1, 2),
    new THREE.MeshStandardMaterial({ color: 0x1a3a2a })
  );
  board.position.y = 0.05;
  state.scene.add(board);
  // Capacitor body
  state.capMat = new THREE.MeshStandardMaterial({ color: 0x222244, emissive: 0x000022 });
  state.cap = new THREE.Mesh(
    new THREE.CylinderGeometry(0.3, 0.3, 1.0, 32),
    state.capMat
  );
  state.cap.position.set(0, 0.65, 0);
  state.scene.add(state.cap);
  // Capacitor leads
  const leadMat = new THREE.MeshStandardMaterial({ color: 0x888888 });
  const leadGeo = new THREE.CylinderGeometry(0.03, 0.03, 0.5, 8);
  const lead1 = new THREE.Mesh(leadGeo, leadMat);
  lead1.position.set(-0.15, 0.15, 0);
  state.scene.add(lead1);
  const lead2 = new THREE.Mesh(leadGeo, leadMat);
  lead2.position.set(0.15, 0.15, 0);
  state.scene.add(lead2);
  state.V0 = 5.0;
};
ctx.onFrame = (api) => {
  const Vc = api.getValue("cap.v", api.sampleIndex);
  const v = Number.isFinite(Vc) ? Vc : 0;
  const frac = Math.min(v / api.state.V0, 1.0);
  if (api.state.capMat) {
    api.state.capMat.emissive.setRGB(0, frac * 0.2, frac * 0.8);
    api.state.capMat.emissiveIntensity = frac * 2.0;
  }
};`}
  />
</TutorialLayout>
