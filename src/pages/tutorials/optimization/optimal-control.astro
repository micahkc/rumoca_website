---
import TutorialLayout from '../../../layouts/TutorialLayout.astro';
import PythonWorkflow from '../../../components/tutorials/PythonWorkflow';
---

<TutorialLayout
  title="Optimal Control with CasADi"
  breadcrumbs={[
    { label: 'Tutorials', href: '/tutorials' },
    { label: 'Optimization & MPC', href: '/tutorials' },
    { label: 'Optimal Control' },
  ]}
  prev={{ label: 'Quadrotor', href: '/tutorials/controls/quadrotor' }}
  next={{ label: 'Pendulum Swing-Up', href: '/tutorials/optimization/pendulum-swingup' }}
>
  <p class="text-text-muted leading-relaxed mb-4">
    The highest-impact use case for researchers: write your OCP dynamics in Modelica,
    let Rumoca generate the CasADi symbolic expressions, then use CasADi's
    <code class="font-mono text-sm text-accent">opti</code> interface to solve the optimal control problem.
  </p>

  <PythonWorkflow
    client:only="react"
    initialSource={`model MassSpringDamper
  Real x(start = 1);
  Real v(start = 0);
  parameter Real k = 1, c = 0.1, m = 1;
  input Real u;
equation
  der(x) = v;
  m * der(v) = -k * x - c * v + u;
end MassSpringDamper;`}
    modelName="MassSpringDamper"
    backend="casadi"
    pipInstalls={['casadi']}
    title="Optimal Control with CasADi"
    pythonTemplate={`{generated_code}

import casadi as ca

opti = ca.Opti()
N = 50; dt = 0.1
X = opti.variable(2, N+1)
U = opti.variable(1, N)

# Dynamics constraints
for k in range(N):
    opti.subject_to(X[:, k+1] == X[:, k] + dt * f(X[:, k], U[:, k], p_val))

# Cost: minimize control effort
opti.minimize(ca.sumsqr(U))
opti.solver('ipopt')
sol = opti.solve()`}
  />
</TutorialLayout>
