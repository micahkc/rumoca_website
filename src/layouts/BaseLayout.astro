---
import '../styles/global.css';
import Navbar from '../components/nav/Navbar.astro';
import Footer from '../components/common/Footer.astro';

interface Props {
  title: string;
  description?: string;
  fullScreen?: boolean;
}

const { title, description = 'Modelica as a Universal Symbolic Frontend. Open source. Written in Rust. Runs in your browser.', fullScreen = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/images/rumoca.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline src="/coi-serviceworker.js"></script>
  </head>
  <body class={fullScreen ? 'flex flex-col h-screen overflow-hidden' : ''}>
    <Navbar />
    <main class={fullScreen ? 'flex-1 overflow-hidden' : ''}>
      <slot />
    </main>
    {!fullScreen && <Footer />}
  </body>
</html>
