<section class="py-16 border-t border-border bg-surface">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid sm:grid-cols-3 gap-6 text-center">
      <div class="p-6 rounded-xl bg-bg border border-border">
        <div class="text-xs font-mono text-text-muted mb-3 uppercase tracking-wider">Binary installer</div>
        <code class="text-xs font-mono text-accent break-all">curl --proto '=https' --tlsv1.2 -LsSf https://raw.githubusercontent.com/cognipilot/rumoca/main/install/install.sh | bash</code>
      </div>

      <div class="p-6 rounded-xl bg-bg border border-border">
        <div class="text-xs font-mono text-text-muted mb-3 uppercase tracking-wider">Python</div>
        <code class="text-sm font-mono text-accent">pip install rumoca</code>
      </div>

      <div class="p-6 rounded-xl bg-bg border border-border">
        <div class="text-xs font-mono text-text-muted mb-3 uppercase tracking-wider">Try instantly</div>
        <a href="https://rumoca.cognipilot.org/" target="_blank" rel="noopener noreferrer" class="text-sm font-mono text-accent hover:text-accent-hover transition-colors underline">
          Open Playground &rarr;
        </a>
      </div>
    </div>
  </div>
</section>
