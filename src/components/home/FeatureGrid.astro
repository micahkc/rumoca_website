---
const features = [
  {
    title: 'Full Compiler Pipeline',
    description: 'Parse, resolve, typecheck, instantiate, flatten, and lower Modelica models into robust canonical DAE forms.',
  },
  {
    title: 'Multi-Backend Export',
    description: 'Generate equation systems and code targeting symbolic, numerical, learned, and embedded workflows across Julia, Python, and beyond.',
  },
  {
    title: 'Robust DAE Simulation',
    description: 'Rust-native simulation with exact AD Jacobians, structural preparation, IC planning, and solver fallbacks.',
  },
  {
    title: 'Modern Tooling',
    description: 'LSP server, formatter, linter, Python bindings, WASM support, and VS Code extension.',
  },
  {
    title: 'Open Source',
    description: 'Apache-2.0. Native binary, Python wheel, and WebAssembly. Distributed from GitHub Releases.',
  },
];
---

<section class="py-20 border-t border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-text text-center mb-4">
      Features
    </h2>
    <p class="text-text-muted text-center max-w-2xl mx-auto mb-16">
      Everything you need to bridge Modelica and modern scientific computing.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-10">
      {features.map(({ title, description }) => (
        <div class="group border-l-2 border-border pl-5 hover:border-accent transition-colors">
          <h3 class="text-lg font-semibold text-text mb-1">{title}</h3>
          <p class="text-sm text-text-muted leading-relaxed">{description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
